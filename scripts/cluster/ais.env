#!/usr/bin/env bash
# 强制经跳板用 vcctl（覆盖 muxi 本机 kubectl 旁路）
# 用法: source scripts/cluster/ais.env && source scripts/cluster/huawei.env  # 或 muxi.env
#
# 2026-09-05：AIS 已回收，禁止自动探测。这里改指向 afs-cpu。
export CLUSTER_SSH_HOST=afs-cpu
export CLUSTER_FORCE_JUMP=1
export CLUSTER_EXEC_MODE=vcctl
echo "CLUSTER_SSH_HOST=$CLUSTER_SSH_HOST (afs-cpu; AIS recycled, no auto-probe)" >&2
